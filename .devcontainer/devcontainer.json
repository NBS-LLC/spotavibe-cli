{
  "name": "spotavibe-cli",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "overrideCommand": true,
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "denoland.vscode-deno"
      ],
      "settings": {
        "deno.enable": true,
        "deno.lint": true,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "denoland.vscode-deno",
        "[typescript]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        },
        "[json]": {
          "editor.defaultFormatter": "denoland.vscode-deno"
        }
      }
    }
  },
  "postCreateCommand": "git config --global --add safe.directory '*' && deno install"
}
