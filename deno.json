{
  "tasks": {
    "start": "deno run --env --allow-net --allow-env --allow-write --allow-read src/main.ts",
    "dev": "deno run --env --watch --allow-net --allow-env --allow-write --allow-read src/main.ts",
    "test": "deno test --env --allow-net --allow-env",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.11",
    "@std/cli": "jsr:@std/cli@^1.0.14",
    "@std/csv": "jsr:@std/csv@^1.0.5"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  }
}
